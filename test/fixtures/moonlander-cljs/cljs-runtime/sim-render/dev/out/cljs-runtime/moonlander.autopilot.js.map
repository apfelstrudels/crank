(ns moonlander.autopilot
  "The guidance brain behind autoland: a proven bang-bang controller shared
   by the game loop (hold-A autoland) and the headless test suite, which has
   always landed with it.

   The controller never refuses an approach. Even when no feasible landing
   exists - dry tank, bad approach, hostile terrain - it keeps issuing
   commands and fires whatever thrust remains, flying best-effort to
   minimize the impact.")

(defn- descent-cap
  "Fastest descent rate (rows/s) that still leaves the main engine room to
   brake to the safe touchdown speed from this altitude, with a 30% margin
   for the per-tick bang-bang overshoot. High up this cruises fast - a
   hover-descent at the gentle final rate burns the whole tank before the
   ground arrives once gravity escalates; near the ground it tapers to the
   gentle final-approach rate. The vertical braking force is the cos
   component of the axial main thrust, so the current lean shrinks the
   budget."
  [{:keys [gravity main-thrust]} angle alt]
  (let [rad   (* angle (/ Math/PI 180.0))
        brake (max 0.0 (- (* main-thrust (Math/cos rad)) gravity))]
    (-> (Math/sqrt (* 2.0 brake 0.7 (max 0.0 alt)))
        (min 8.0)
        (max 2.2))))

(defn commands
  "Thrust flags for this tick. Under tilt physics the side engines are
   attitude thrusters, so the brain flies an attitude plan: pick a target
   lean from the lateral velocity error (lean toward where the pad wants
   us to accelerate), fade that lean to zero near the ground so the craft
   is level at touchdown, and bang-bang the side engines on the spin rate
   to track the plan. The main engine fires along the axis to brake the
   descent, and that burn doubles as the lateral engine: the lean picks
   how much of it goes sideways. Pure function of the game state; returns
   {:up? bool :left? bool :right? bool}."
  [{:keys [lander terrain params] :as s}]
  (let [pad-c   (/ (+ (:start (:pad terrain)) (:end (:pad terrain))) 2)
        ;; Grid dims ride along with the terrain that was generated for
        ;; them, so this ns stays a leaf with no mirror of core/config.
        cols    (count (:heights terrain))
        rows    (:rows terrain)
        c       (-> (:x lander) (max 0) (min (dec cols)) int)
        g-row   (- rows 1 (nth (:heights terrain) c))
        alt     (- g-row (inc (:y lander)))
        dx      (- pad-c (:x lander))
        ;; Aim for a brisk horizontal speed toward the pad - lateral
        ;; motion costs main-engine fuel under tilt physics (gravity tax
        ;; is paid for every second aloft), so the traverse has to happen
        ;; fast, not at the old gentle pace. The taper gains on dx so the
        ;; approach is already slow when the pad is close (a hot arrival
        ;; cannot be braked without altitude). Below the assist's engage
        ;; altitude the speed is capped under the assist's own drift cap:
        ;; any faster and the always-on assist leans against the drift,
        ;; fighting the autopilot - both engines burn while the torques
        ;; cancel - and the faded near-ground lean can barely brake a hot
        ;; arrival anyway.
        vx-max  (min 6.5 (max 0.8 (* 0.4 alt))
                     (if (< alt 8.0) 2.0 6.5))
        vx-want (* (if (neg? dx) -1.0 1.0) (min (* 0.45 (Math/abs dx)) vx-max))
        vx-err  (- vx-want (:vx lander))
        ;; Attitude plan: the lean sets the lateral split of the axial
        ;; main burn. While the descent cap holds the burn duty at the
        ;; vertical-hold rate, a steady lean theta yields an average
        ;; lateral accel of g*tan(theta); aim the thrust axis so that
        ;; g*tan(theta) = a-want, the lateral acceleration the velocity
        ;; error calls for.
        a-want  (-> (* 1.5 vx-err) (max -5.0) (min 5.0))
        lean-ff (* (Math/atan (/ a-want (:gravity params)))
                   (/ 180.0 Math/PI))
        ;; High up the lean is free; near the ground it is capped just
        ;; inside the touchdown tolerance - nulling the angle matters at
        ;; touchdown, but a small in-tolerance lean is exactly how the
        ;; last lateral error gets killed.
        lean-max (max 5.0 (* 38.0 (min 1.0 (/ alt 10.0))))
        ang-want (-> lean-ff (max (- lean-max)) (min lean-max))
        ang-err  (- ang-want (:angle lander))
        ;; Spin plan: proportional on the angle error, but never faster
        ;; than the side engines can brake back from by the time the
        ;; target angle is reached (sqrt braking curve) - a hot spin
        ;; arrival swings the lean past the plan and rings the traverse.
        ;; The hysteresis is wide: side-engine taps cost real fuel now,
        ;; and the angular damping already quiets small spin errors.
        spin-cap (min 35.0 (Math/sqrt (* 2.0 60.0 (Math/abs ang-err))))
        spin-want (-> (* 3.5 ang-err) (max (- spin-cap)) (min spin-cap))
        spin     (:spin lander)
        ;; Never out-descend the traverse: while the pad is far off to the
        ;; side, hold a rate that still leaves the lateral steering time
        ;; to get above the pad before the ground arrives; once roughly
        ;; overhead, the braking cap rules.
        cap     (min (descent-cap params (:angle lander) alt)
                     (max 2.2 (* 4.5 (/ alt (max 1.0 (Math/abs dx))))))]
    {:up?    (> (:vy lander) cap)
     ;; right engine = positive torque = spin up toward a rightward lean;
     ;; fire it while the spin lags the plan, mirrored for left.
     :left?  (> spin (+ spin-want 4.0))
     :right? (< spin (- spin-want 4.0))}))
