(ns moonlander.render
  "Renderer seam: every draw call in the game loop goes through here, never
   to a concrete renderer directly.

   The seam owns renderer selection and lifecycle:

   - `register!` lets a renderer implementation (e.g. moonlander.render.pixi,
     which only exists in the browser app build) offer itself. Implementations
     register a start fn of `config -> js/Promise` that resolves to a live
     renderer map `{:id keyword :draw! (fn [config state])}` or rejects when
     the environment can't host it (no WebGL, init failure).
   - `start!` resolves which renderer to use once at game start: the
     `?renderer=` URL parameter wins over `window.MOONLANDER_CONFIG.RENDERER`,
     and the code default applies when neither is set. The ASCII renderer is
     always available and is the fallback whenever the requested renderer is
     unknown, unregistered, or fails to start.
   - `draw!` renders one frame through the active renderer.

   Everything in this namespace is safe to load headlessly: no window or
   document is touched until `start!`/`draw!` are called, so the :sim test
   build can require it without a DOM (and without pixi.js)."
  (:require [moonlander.render.ascii :as ascii]))

;; Renderer implementations registered at namespace load (browser app build
;; only). id -> (fn [config] -> js/Promise of {:id :draw!}).
(defonce ^:private registry (atom {}))

;; The live renderer: {:id :draw!}, where :draw! is (fn [config state]).
;; nil until `start!` runs; `draw!` is a no-op before that.
(defonce ^:private active (atom nil))

(defn register!
  "Register a renderer implementation's start fn under `id`. Called at
   namespace load by renderer implementations (e.g. moonlander.render.pixi)."
  [id start-fn]
  (swap! registry assoc id start-fn))

;; The renderer used when nothing asks for anything else. Flipped to :pixi
;; in Phase 3 of the sprite engine migration (captain's verdict on the
;; Phase 2 review board, 2026-10-18). Rollback is one config value:
;; MOONLANDER_CONFIG.RENDERER = "ascii", or ?renderer=ascii in the URL.
;; WebGL-less browsers fall back to ASCII automatically either way.
(def default-renderer :pixi)

(defn- el [id]
  (when (exists? js/document)
    (.getElementById js/document id)))

(defn- ascii-renderer
  "The always-available renderer: writes the ASCII frame into <pre
   id=\"screen\">. `config` rides along per call so hot reload picks up
   display-config changes."
  []
  {:id    :ascii
   :draw! (fn [config s]
            (when-let [screen (el "screen")]
              (set! (.-textContent screen)
                    (ascii/render config s))))})

(defn requested-renderer
  "The renderer the environment asks for: `?renderer=<id>` in the page URL
   wins over `window.MOONLANDER_CONFIG.RENDERER`; both are optional and
   parse to a keyword (nil when unset/unparseable). Kept separate from
   `start!` so selection is auditable and cheap to test."
  []
  (when (exists? js/window)
    (let [from-url (some-> js/window .-location .-search
                           (js/URLSearchParams.)
                           (.get "renderer"))
          from-cfg (some-> js/window .-MOONLANDER_CONFIG .-RENDERER)]
      (or (some-> from-url not-empty keyword)
          (some-> from-cfg not-empty keyword)
          default-renderer))))

(defn start!
  "Resolve and start the renderer for this session. Always installs the
   ASCII renderer first so every frame has a working draw path; when a
   different renderer was requested and is registered, starts it and swaps
   it in once ready. A start failure (rejected promise or thrown error)
   leaves ASCII active - the automatic fallback for WebGL-less browsers."
  [config]
  (reset! active (ascii-renderer))
  (let [want (requested-renderer)]
    (when-let [start (and (some? want)
                          (not= :ascii want)
                          (get @registry want))]
      (try
        (-> (js/Promise.resolve (start config))
            (.then (fn [impl]
                     (when (and impl (:draw! impl))
                       (reset! active impl))))
            (.catch (fn [err]
                      (.warn js/console
                             (str "moonlander: renderer " (name want)
                                  " failed to start, staying on ASCII: "
                                  (.-message err))))))
        (catch :default err
          (.warn js/console
                 (str "moonlander: renderer " (name want)
                      " failed to start, staying on ASCII: "
                      (.-message err)))))))
  nil)

(defn draw!
  "Render one frame of `state` through the active renderer. No-op before
   `start!` (and headlessly, where no renderer is ever started)."
  [config s]
  (when-let [r @active]
    ((:draw! r) config s)))

(defn active-renderer-id
  "The id of the live renderer (:ascii, :pixi, ...). Diagnostic for the
   review console and future telemetry."
  []
  (some-> @active :id))
