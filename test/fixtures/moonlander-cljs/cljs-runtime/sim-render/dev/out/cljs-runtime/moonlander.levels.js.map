(ns moonlander.levels
  "Seeded procedural level generation and per-level difficulty tuning.

   Everything here is deterministic: the same base seed and level number
   always produce the same terrain, pad placement, and star field, so
   rounds are reproducible and the headless test suite can rely on them.")

(def ^:const modulus 4294967296) ; 2^32

(defn make-rng
  "Returns a deterministic PRNG (linear congruential generator) as a
   zero-arg fn yielding doubles in [0, 1)."
  [seed]
  (let [s (atom (mod (long seed) modulus))]
    (fn []
      (swap! s #(mod (+ (* % 1664525) 1013904223) modulus))
      (/ @s (double modulus)))))

(defn- rand-int* [rng n]
  (long (* n (rng))))

;; ---------------------------------------------------------------------------
;; Difficulty curve

(def base-params
  "Level-1 physics and tuning; `params-for-level` escalates from here.
   Scaled for the display grid in moonlander.core/config (120x43).
   Gravity is deliberately gentler than the classic 9.0: the whole curve
   is scaled by 0.9 so descents are a touch more forgiving."
  {:gravity     8.1    ; rows per second^2, downward
   :main-thrust 18.0   ; rows per second^2, along the lander's axis
   :ang-torque  120.0  ; deg per second^2, angular accel per side engine
   :ang-damp    3.0    ; 1/s angular damping on the spin rate
   :fuel-start  180.0
   :burn-main   13.5   ; fuel per second while main engine fires
   :burn-side   6.0    ; fuel per second per side engine
   :safe-vy     3.0    ; max vertical speed (rows/s) for a safe landing
   :safe-vx     1.5    ; max horizontal speed (cols/s) for a safe landing
   :safe-angle  8.0    ; max |angle| (deg from level) for a safe landing
   :pad-width   8      ; landing pad width in columns
   :max-terrain 8      ; max terrain relief in rows above the floor
   :roughness   1.0    ; scales the random-walk step of the ridge line
   :assist-alt  8.0})  ; rows above ground where the landing assist engages

(defn params-for-level
  "Difficulty escalates with level: stronger gravity, less fuel, narrower
   pads, and rougher terrain. (The moon is an airless body: the old
   cross-wind parameter was removed outright, not replaced - the
   remaining four escalation axes still steepen the curve on their own.)"
  [level]
  (let [l (dec level)]
    (assoc base-params
           :gravity     (* 0.9 (min 13.5 (+ 9.0 (* 0.75 l))))
           :fuel-start  (max 105.0 (- 180.0 (* 12.0 l)))
           :pad-width   (max 4 (- 8 (quot l 2)))
           :max-terrain (min 12 (+ 8 (quot l 2)))
           :roughness   (min 2.5 (+ 1.0 (* 0.25 l))))))

;; ---------------------------------------------------------------------------
;; Landing pad designations (Apollo-era names, shown in the HUD)

(def ^:private pad-names
  ["TRANQUILITY" "FRA MAURO" "HADLEY" "DESCARTES" "TAURUS-LITTROW"
   "OCEANUS" "COPERNICUS" "KEPLER" "ARISTARCHUS" "SURVEYOR"
   "ALPHONSUS" "TYCHO"])

(defn pad-name
  "Apollo-era designation for the landing pad on `level`, e.g.
   \"TRANQUILITY PAD 03\". The name cycles through `pad-names`; the pad
   number is the level number (zero-padded)."
  [level]
  (let [nm (nth pad-names (mod (dec level) (count pad-names)))]
    (str nm " PAD " (if (< level 10) "0" "") level)))

;; ---------------------------------------------------------------------------
;; Generation

(defn level-seed
  "Derives the generation seed for `level` from the game's base seed."
  [base-seed level]
  (mod (+ (long base-seed) (* (long level) 2654435761)) modulus))

(defn gen-terrain
  "Random-walk ridge heights with one flat landing pad segment.
   Returns {:heights [int per column] :pad {:start :end} :rows rows};
   :rows rides along so consumers (e.g. the autopilot) can locate the
   ground without mirroring the display config."
  [{:keys [cols rows]} {:keys [pad-width max-terrain roughness]} seed]
  (let [rng       (make-rng seed)
        pad-start (+ 2 (rand-int* rng (- cols pad-width 4)))
        pad-end   (+ pad-start pad-width -1)
        pad-h     (+ 1 (rand-int* rng 2))
        step      (* 1.5 roughness)
        raw       (loop [c   0
                         h   (double (inc (rand-int* rng max-terrain)))
                         acc (transient [])]
                    (if (= c cols)
                      (persistent! acc)
                      (let [h' (-> (+ h (* step (- (rng) 0.5)))
                                   (max 1.0)
                                   (min (double max-terrain)))]
                        (recur (inc c) h' (conj! acc h')))))
        heights   (mapv (fn [c]
                          (if (<= pad-start c pad-end)
                            pad-h
                            (long (Math/round (nth raw c)))))
                        (range cols))]
    {:heights heights
     :pad     {:start pad-start :end pad-end}
     :rows    rows}))

(defn gen-stars
  "Background star field: a vector of {:x :y :layer}. Layer 0 stars are far
   (static), layer 1 stars are near (they drift against the lander's motion
   for a parallax effect). Stars stay above the terrain band: the y range
   respects the level's max-terrain relief, so no star ever spawns inside
   the ground even on the roughest high levels."
  [{:keys [cols rows]} {:keys [max-terrain]} seed]
  (let [rng (make-rng (mod (bit-xor (long seed) 0x5bd1e995) modulus))
        n   (max 12 (quot (* cols rows) 16))
        ;; ground tops out at row (- rows 1 max-terrain); stars stay above it
        max-y (max 1 (- rows 1 max-terrain))]
    (mapv (fn [_]
            {:x     (rand-int* rng cols)
             :y     (rand-int* rng max-y)
             :layer (rand-int* rng 2)})
          (range n))))
