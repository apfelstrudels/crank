(ns moonlander.core
  "Lunar Lander. The player descends a lander under gravity with
   limited fuel and must touch down gently on the landing pad.

   Levels are generated procedurally (see moonlander.levels): each level has
   its own terrain, pad placement, star field, and difficulty parameters.
   Land to advance to the next level; crash and you retry the same one.

   Design notes:
   - Display dimensions live in `config`; gameplay tunables come from
     `moonlander.levels/params-for-level` and ride along in the state map.
   - Game state is a single immutable map in `state`; `step` is a pure
     transition, so levels, replays, and tests are easy to drive.
   - Rendering is a pure projection of state and lives behind the
     moonlander.render seam (ASCII in moonlander.render.ascii, sprites in
     moonlander.render.pixi); all animation is a pure function of the
     elapsed time `:t` carried in the state."
  (:require [moonlander.autopilot :as autopilot]
            [moonlander.leaderboard :as leaderboard]
            [moonlander.levels :as levels]
            [moonlander.render :as renderer]
            [moonlander.render.ascii :as ascii]))

;; ---------------------------------------------------------------------------
;; Configuration (display only - gameplay tunables live in moonlander.levels)

(def config
  {:cols      120   ; grid width in characters
   :rows      43    ; grid height in characters
   :spawn-y   2.0   ; spawn height (row, counted from the top)
   :alt-scale 20.0  ; display: meters per row
   :vel-scale 10.0}) ; display: m/s per row/s

;; ---------------------------------------------------------------------------
;; State

(defonce state (atom nil))

(defn new-round
  "Start a new game. With no arguments picks a random base seed; pass a
   seed (and optionally a level) for deterministic, reproducible rounds."
  ([] (new-round (long (* (rand) levels/modulus))))
  ([seed] (new-round seed 1))
  ([seed level]
   (let [params  (levels/params-for-level level)
         lseed   (levels/level-seed seed level)
         terrain (levels/gen-terrain config params lseed)
         stars   (levels/gen-stars config params lseed)
         {:keys [cols spawn-y]} config]
     {:status       :flying
      :message      nil
      :level        level
      :seed         seed
      :t            0.0
      :params       params
      :terrain      terrain
      :stars        stars
      :explosion    nil
      ;; Autoland engagement: `:auto?` is true while A is held; `:used-auto?`
      ;; latches on the first engagement and decides the AUTO/MANUAL flag
      ;; recorded at touchdown. `:assist?` and `:burn` are per-tick outputs
      ;; for the HUD and the flame renderer.
      :auto?        false
      :used-auto?   false
      :assist?      false
      :landing-mode nil
      :burn         {:up? false :left? false :right? false}
      :lander       {:x     (/ cols 2)
                     :y     spawn-y
                     :vx    0.0
                     :vy    0.0
                     ;; Attitude: angle in degrees from level (positive =
                     ;; top tips right) and spin in deg/s. The side engines
                     ;; change these - they lean the craft, they do not
                     ;; translate it; the main engine fires along the axis.
                     :angle 0.0
                     :spin  0.0
                     :fuel  (:fuel-start params)
                     :up?   false :left? false :right? false}})))

(defn next-level
  "Fresh round on the next level, same base seed."
  [{:keys [seed level]}]
  (new-round seed (inc level)))

(defn retry-level
  "Fresh round on the same level (identical terrain), same base seed."
  [{:keys [seed level]}]
  (new-round seed level))

;; ---------------------------------------------------------------------------
;; Physics

(defn- ground-row
  "Top row index occupied by ground at `col`."
  [{:keys [rows cols]} heights col]
  (let [c (-> col (max 0) (min (dec cols)) int)]
    (- rows 1 (nth heights c))))

(defn- on-pad? [{:keys [pad]} x]
  (<= (:start pad) (int x) (:end pad)))

(defn- touchdown-message
  "The end-of-round overlay/message text for a touchdown or crash at `level`,
   tagged with the AUTO/MANUAL `mode`. Factored out of `step` so the replay
   driver can rebuild it when overriding the displayed landing mode."
  [level safe? mode]
  (let [mode-str (if (= :auto mode) "AUTO" "MANUAL")]
    (if safe?
      (str "*** TOUCHDOWN! Level " level " complete."
           " LANDING: " mode-str
           " [R] for level " (inc level) " ***")
      (str "*** CRASH! Too fast, off-pad, or tipped over."
           " LANDING: " mode-str
           " [R] to retry level " level " ***"))))

(defn- assist-flags
  "Always-on landing assist: near the ground, adds thrust to cap the descent
   rate and horizontal speed at the safe-landing limits. It only ever ADDS
   thrust - it dampens, it does not fly the ship - and it never sets the
   AUTO flag. It burns the player's fuel; with a dry tank there is nothing
   to burn and it stays out of the way. The caps sit at 75% of the safe
   limits, leaving margin for the per-tick bang-bang overshoot."
  [{:keys [lander terrain params]}]
  (let [{:keys [safe-vy safe-vx safe-angle assist-alt]} params
        cap-vy   (* 0.75 safe-vy)
        cap-vx   (* 0.75 safe-vx)
        cap-lean (* 0.75 safe-angle)
        cap-spin 20.0 ; deg/s; spin faster than this always gets countered
        g-row (ground-row config (:heights terrain) (:x lander))
        alt   (- g-row (inc (:y lander)))
        {:keys [vx angle spin]} lander
        ;; Under tilt physics the drift response can only lean the craft;
        ;; the lean is then converted into lateral braking whenever the
        ;; descent cap fires the main engine. (It must never add main
        ;; thrust for drift by itself - near-hover that climbs, and the
        ;; climb is a fuel sink and a new hazard.)
        drift-l? (> vx cap-vx)    ; drifting right: must lean left
        drift-r? (< vx (- cap-vx))
        lean-rate 10.0            ; deg/s; drift leans build gently, so a
                                    ; cleared drift never leaves a spin
    ]
    (if (and (pos? (:fuel lander)) (<= alt assist-alt))
      {:up?    (> (:vy lander) cap-vy)
       ;; left engine = lean left (negative torque): counters a rightward
       ;; drift (only while there is lean room left and the craft is not
       ;; already swinging left - the runaway tip-over guard), a right
       ;; lean, or a rightward spin; right engine mirrors.
       :left?  (or (> angle cap-lean) (> spin cap-spin)
                   (and drift-l? (> angle (- cap-lean))
                        (> spin (- lean-rate))))
       :right? (or (< angle (- cap-lean)) (< spin (- cap-spin))
                   (and drift-r? (< angle cap-lean)
                        (< spin lean-rate)))}
      {:up? false :left? false :right? false})))

(defn step
  "Pure state transition. `dt` is seconds elapsed. Elapsed time `:t` always
   advances (it drives the animations), even after the round has ended."
  [{:keys [lander terrain params] :as s} dt]
  (let [t' (+ (:t s) dt)]
    (if (not= :flying (:status s))
      (assoc s :t t')
      (let [{:keys [gravity main-thrust ang-torque ang-damp safe-vy safe-vx
                    safe-angle burn-main burn-side]} params
            fuel     (:fuel lander)
            engaged? (boolean (:auto? s))
            ;; Hybrid control: hold-A autoland hands the sticks to the
            ;; autopilot (it never refuses, even on an infeasible approach);
            ;; otherwise the player's flags rule. The always-on assist only
            ;; ORs in extra braking thrust near the ground.
            base     (if engaged?
                       (autopilot/commands s)
                       (select-keys lander [:up? :left? :right?]))
            assist   (assist-flags s)
            eff      (merge-with #(or %1 %2) base assist)
            up?      (and (:up? eff) (pos? fuel))
            left?    (and (:left? eff) (pos? fuel))
            right?   (and (:right? eff) (pos? fuel))
            burn     (+ (if up? burn-main 0)
                        (if left? burn-side 0)
                        (if right? burn-side 0))
            fuel'    (max 0.0 (- fuel (* burn dt)))
            ;; Angular dynamics: the side engines are attitude thrusters -
            ;; they apply a damped angular acceleration (left leans left,
            ;; right leans right) and the craft carries the momentum.
            ;; Both engines together cancel (autopilot and assist commands
            ;; are OR-merged and can disagree).
            ang-acc (+ (if left? (- ang-torque) 0.0)
                       (if right? ang-torque 0.0))
            spin'   (+ (:spin lander)
                       (* (- ang-acc (* ang-damp (:spin lander))) dt))
            angle'  (+ (:angle lander) (* spin' dt))
            ;; The main engine fires along the lander's axis: leaned right
            ;; it pushes right, leaned left it pushes left, and only the
            ;; cos component brakes the fall.
            rad     (* angle' (/ Math/PI 180.0))
            ax      (if up? (* main-thrust (Math/sin rad)) 0.0)
            ay      (- gravity (if up? (* main-thrust (Math/cos rad)) 0.0))
            vx'     (+ (:vx lander) (* ax dt))
            vy'     (+ (:vy lander) (* ay dt))
            x'      (-> (+ (:x lander) (* vx' dt))
                        (max 0) (min (dec (:cols config))))
            y'      (max 0.0 (+ (:y lander) (* vy' dt)))
            g-row   (ground-row config (:heights terrain) x')
            ;; lander body occupies rows y-1 .. y+1; feet at y+1
            touched (>= (inc y') g-row)
            used-auto' (or (:used-auto? s) engaged?)
            assist-on? (boolean (and (pos? fuel) (some true? (vals assist))))
            s'        (assoc s :t t'
                             :used-auto? used-auto'
                             :assist? assist-on?
                             :burn {:up? up? :left? left? :right? right?})]
        (if-not touched
          (assoc s' :lander (assoc lander :x x' :y y' :vx vx' :vy vy'
                                   :angle angle' :spin spin' :fuel fuel'))
          (let [safe?   (and (on-pad? terrain x')
                             (<= (Math/abs vy') safe-vy)
                             (<= (Math/abs vx') safe-vx)
                             (<= (Math/abs angle') safe-angle))
                lander' (assoc lander :x x' :y (dec g-row)
                               :vx 0.0 :vy 0.0 :angle 0.0 :spin 0.0 :fuel fuel'
                               :up? false :left? false :right? false)
                level   (:level s)
                ;; Flag every landing AUTO or MANUAL for future scoring.
                ;; Assist use never sets it; only hold-A autoland does.
                mode     (if used-auto' :auto :manual)]
            (assoc s'
                   :lander lander'
                   :landing-mode mode
                   :explosion (when-not safe?
                                {:x (int x') :y (dec g-row) :t0 t'})
                   :status (if safe? :landed :crashed)
                   :message (touchdown-message level safe? mode))))))))

;; ---------------------------------------------------------------------------
;; Rendering
;;
;; The renderers live behind the moonlander.render seam: the ASCII renderer
;; in moonlander.render.ascii (extracted verbatim in Phase 0 of the sprite
;; engine migration), any sprite engine beside it. The delegates below keep
;; the pre-seam names `render` and `lander-cells` working for the headless
;; test suite, which asserts on the ASCII oracle.

(defn render
  "ASCII rendering of one frame, as a single string. Thin delegate to
   moonlander.render.ascii/render (the headless test oracle)."
  [s]
  (ascii/render config s))

(def lander-cells
  "ASCII glyph cells for the lander at a given angle; thin alias of
   moonlander.render.ascii/lander-cells."
  ascii/lander-cells)

;; ---------------------------------------------------------------------------
;; HUD

(defn- el [id] (.getElementById js/document id))

(defn- pad2 [v] (if (< v 10) (str "0" v) (str v)))

(defn hud-readout
  "Mission-control style HUD readout as pure data (testable headlessly).
   Fixed labels and units: ALT 0380 M, VS +11 M/S, HS +02 M/S, PROP 74%,
   plus the level, the target pad designation, and the guidance mode
   (GUID: AUTO while hold-A autoland flies, ASSIST while the landing assist
   is dampening, MAN otherwise; the latched AUTO/MANUAL flag once down)."
  [{:keys [lander terrain params level status auto? assist? landing-mode]}]
  (let [{:keys [alt-scale vel-scale]} config
        g-row (ground-row config (:heights terrain) (:x lander))
        alt   (* alt-scale (max 0.0 (- g-row (inc (:y lander)))))
        vs    (* vel-scale (:vy lander))
        hs    (* vel-scale (:vx lander))
        fmt-v (fn [v]
                (str (if (neg? v) "-" "+")
                     (pad2 (int (min 99 (Math/abs v))))))]
    {:level (str level)
     :alt   (str (apply str (repeat (max 0 (- 4 (count (str (int alt))))) "0"))
                 (int alt) " M")
     :vs    (str (fmt-v vs) " M/S")
     :hs    (str (fmt-v hs) " M/S")
     :tilt  (str (fmt-v (:angle lander)) " DEG")
     :prop  (str (int (* 100.0 (/ (:fuel lander) (:fuel-start params)))) " %")
     :pad   (levels/pad-name level)
     :auto  (cond
              (#{:landed :crashed} status)
              (if (= :auto landing-mode) "AUTO" "MANUAL")
              auto?   "AUTO"
              assist? "ASSIST"
              :else   "MAN")}))

(defn update-hud! [s]
  (let [{:keys [level alt vs hs tilt prop pad auto]} (hud-readout s)]
    (set! (.-textContent (el "hud-level")) level)
    (set! (.-textContent (el "hud-alt")) alt)
    (set! (.-textContent (el "hud-vvel")) vs)
    (set! (.-textContent (el "hud-hvel")) hs)
    (set! (.-textContent (el "hud-tilt")) tilt)
    (set! (.-textContent (el "hud-fuel")) prop)
    (set! (.-textContent (el "hud-pad")) pad)
    (set! (.-textContent (el "hud-auto")) auto)))

;; ---------------------------------------------------------------------------
;; Replay theater
;;
;; Playback for an archived flight log (see moonlander.leaderboard/watch!):
;; the log is seed + level + per-tick effective thrust flags, exactly what
;; the server verified at submit time. Replaying it through `step` - the
;; recorded flags applied as raw stick input, just like the server-side
;; verifier - reproduces the stored flight tick-for-tick. Frames are
;; simulated lazily and cached, so even a 20000-tick run starts instantly.

(defn replay-start
  "Build the playback state for a parsed flight log (see
   moonlander.leaderboard/replay-log-from-row). A nil log (legacy or
   corrupt row) yields the :unavailable state - never a crash."
  [log]
  (if (nil? log)
    {:status :unavailable}
    {:status   :ready
     :log      log
     :frames   [(new-round (:seed log) (:level log))]
     :idx      0
     :acc      0.0
     :speed    1
     :playing? true}))

(defn- replay-frame-after
  "Simulate one logged tick from the previous frame: the recorded effective
   flags applied as raw stick input, then one deterministic `step`. This is
   exactly the server verifier's replay path (the recorded burn already
   contains the autopilot/assist output)."
  [frame {:keys [dt up left right]}]
  (step (-> frame
            (assoc-in [:lander :up?] up)
            (assoc-in [:lander :left?] left)
            (assoc-in [:lander :right?] right))
        dt))

(defn- apply-recorded-landing-mode
  "Override a just-landed/crashed replay frame's displayed AUTO/MANUAL flag
   with the mode recorded at verification time. Replaying the recorded
   *effective* thrust flags alone can't tell whether hold-A autoland was
   engaged (the server only stores the merged burn, not the raw `:auto?`
   stick), so the real flag has to ride along with the log instead."
  [frame recorded-mode]
  (if (and recorded-mode (#{:landed :crashed} (:status frame)))
    (assoc frame
           :landing-mode recorded-mode
           :message (touchdown-message (:level frame)
                                        (= :landed (:status frame))
                                        recorded-mode))
    frame))

(defn replay-advance
  "Pure playback step: advance through the log by `wall-dt` seconds of real
   time, consuming logged ticks at their recorded pace scaled by :speed.
   Frames are extended lazily (frame i is the state after i ticks). At the
   end of the log the playback parks on the final frame with :playing?
   false. A paused or finished playback returns unchanged."
  [rp wall-dt]
  (let [ticks (:ticks (:log rp))
        total (count ticks)
        recorded-mode (:landing-mode (:log rp))]
    (if (or (not (:playing? rp)) (>= (:idx rp) total))
      rp
      (let [budget (+ (:acc rp) (* wall-dt (:speed rp)))]
        (loop [idx    (:idx rp)
               frames (:frames rp)
               acc    budget]
          (if (and (< idx total) (>= acc (:dt (nth ticks idx))))
            (recur (inc idx)
                   (conj frames (-> (replay-frame-after (nth frames idx)
                                                        (nth ticks idx))
                                    (apply-recorded-landing-mode recorded-mode)))
                   (- acc (:dt (nth ticks idx))))
            (assoc rp :idx idx :frames frames :acc acc
                   :playing? (< idx total))))))))

;; ---------------------------------------------------------------------------
;; Input

(def key-map
  {"ArrowUp" :up? "w" :up? "W" :up?
   "ArrowLeft" :left?
   "ArrowRight" :right? "d" :right? "D" :right?})

(defn- typing-callsign?
  "True when the event comes from the leaderboard callsign input, so game
   keys (thrust, A, R, L) stay out of the way while typing a nickname."
  [e]
  (let [t (.-target e)]
    (and t (= "INPUT" (.-tagName t)))))

(defn on-key! [down? e]
  (when-not (typing-callsign? e)
    (let [k (.-key e)]
      (if (:replay @leaderboard/ui)
        ;; Replay theater owns the screen: playback keys only.
        (when down?
          (cond
            (= "Escape" k)         (leaderboard/close-replay!)
            (#{"p" "P" " "} k)    (do (.preventDefault e)
                                       (leaderboard/toggle-replay-play!))
            (#{"s" "S" "f" "F"} k) (leaderboard/cycle-replay-speed!)))
        (cond
        (contains? key-map k)
        (do (.preventDefault e)
            (when (= :flying (:status @state))
              (swap! state assoc-in [:lander (key-map k)] down?)))

        ;; Hold A to engage the autoland autopilot; releasing it returns full
        ;; manual control instantly.
        (#{"a" "A"} k)
        (do (.preventDefault e)
            (when (= :flying (:status @state))
              (swap! state assoc :auto? down?)))

        (and down? (#{"r" "R"} k) (#{:landed :crashed} (:status @state)))
        (do (leaderboard/on-new-round!)
            (swap! state (if (= :landed (:status @state)) next-level retry-level)))

        ;; Toggle the leaderboard boards from the end-of-round screen (no-op
        ;; without config).
        (and down? (#{"l" "L"} k) (#{:landed :crashed} (:status @state)))
        (leaderboard/toggle-boards!))))))

;; ---------------------------------------------------------------------------
;; Game loop

(defn- replay-tick!
  "Replay theater owns the screen: advance playback by the elapsed wall
   time and render the current replay frame. The pilot's own round is
   frozen (not stepped, not recorded) until the replay is closed."
  [rp dt]
  (when (= :ready (:status rp))
    (let [rp  (if (:frames rp) rp (replay-start (:log rp)))
          rp' (replay-advance rp dt)]
      (swap! leaderboard/ui assoc :replay rp')
      (when-not (:frames rp)
        ;; first frame: sync the control bar to the fresh playback state
        (leaderboard/update-replay-bar!))
      (when (and (:playing? rp) (not (:playing? rp')))
        (leaderboard/replay-status! "REPLAY COMPLETE"))
      (let [frame (nth (:frames rp') (:idx rp'))]
        (renderer/draw! config frame)
        (update-hud! frame)))))

(defn- tick! [last-t]
  (let [now (.now js/performance)
        dt  (min 0.05 (/ (- now last-t) 1000.0))]
    (if-let [rp (:replay @leaderboard/ui)]
      (replay-tick! rp dt)
      (let [s0 @state
            s1 (swap! state step dt)]
        ;; Record the run as it is played: the dt actually simulated plus
        ;; the effective burn the step applied (autoland/assist already
        ;; merged), which is exactly what the server re-simulates to verify
        ;; the score.
        (when (= :flying (:status s0))
          (leaderboard/record! s0 dt (:burn s1))
          (when (#{:landed :crashed} (:status s1))
            (leaderboard/on-round-ended! s1)))
        (renderer/draw! config s1)
        (update-hud! s1)))
    (.requestAnimationFrame js/window (fn [_] (tick! now)))))

;; ---------------------------------------------------------------------------
;; Entry points

(defn ^:export init! []
  (reset! state (new-round))
  ;; Resolve and start the renderer behind the seam (pixi by default; ASCII
  ;; when requested or as the automatic fallback).
  (renderer/start! config)
  (.addEventListener js/window "keydown" #(on-key! true %))
  (.addEventListener js/window "keyup" #(on-key! false %))
  ;; Replay theater controls (inert until a WATCH action opens the bar).
  (when-let [b (el "rp-play")]
    (.addEventListener b "click" (fn [_] (leaderboard/toggle-replay-play!))))
  (when-let [b (el "rp-speed")]
    (.addEventListener b "click" (fn [_] (leaderboard/cycle-replay-speed!))))
  (when-let [b (el "rp-close")]
    (.addEventListener b "click" (fn [_] (leaderboard/close-replay!))))
  (leaderboard/init-ui!)
  (.requestAnimationFrame js/window (fn [_] (tick! (.now js/performance)))))

(defn ^:dev/after-load reload! []
  ;; Re-render with whatever state survived the hot reload.
  (renderer/draw! config @state)
  (update-hud! @state))
