(ns moonlander.leaderboard
  "Global leaderboard client: run recording, verified score submission, and
   the all-time/daily boards.

   Everything is gated on the config value in public/config.js
   (window.MOONLANDER_CONFIG with SUPABASE_URL + SUPABASE_ANON_KEY). With no
   config present the game behaves exactly as without this namespace: no
   panel, no network calls, no extra keys.

   Recording: the sim is deterministic, so a run is fully described by its
   base seed, level, and the per-tick EFFECTIVE thrust flags - the burn
   actually applied by `step`, after autoland/assist merging and fuel
   gating. The server re-simulates exactly those flags, so the autopilot
   and the assist need no server-side port: their output is already baked
   into the recorded burn.

   The client only ever uses the anon key (read-only via RLS) and the
   submit-score edge function. The service-role key must never appear here."
  (:require [clojure.string :as str]))

;; Server-side caps (supabase/functions/submit-score): keep the recording
;; inside what the endpoint accepts.
(def max-ticks 20000)
(def max-dt 0.05)
(def board-limit 20)

;; ---------------------------------------------------------------------------
;; Config

(defn config
  "The leaderboard config value, or nil when not configured. Reads
   window.MOONLANDER_CONFIG (public/config.js) and requires both values."
  []
  (when (exists? js/window)
    (let [c (.-MOONLANDER_CONFIG js/window)]
      (when (and c (seq (.-SUPABASE_URL c)) (seq (.-SUPABASE_ANON_KEY c)))
        {:url (.-SUPABASE_URL c) :anon-key (.-SUPABASE_ANON_KEY c)}))))

(defn configured? [] (boolean (config)))

;; ---------------------------------------------------------------------------
;; Recording (pure)

(defn new-recording [seed level]
  {:seed seed :level level :seen-t 0.0 :ticks [] :capped? false})

(defn record-tick
  "Append one frame to the recording. `burn` is the effective thrust applied
   by `step` this tick ({:up? :left? :right?}). Frames with dt outside the
   server's accepted range are dropped (a zero-dt frame changes no physics);
   past the server's tick cap the recording stops and is flagged :capped?."
  [rec dt {:keys [up? left? right?]}]
  (cond
    (or (<= dt 0.0) (> dt max-dt))
    rec

    (>= (count (:ticks rec)) max-ticks)
    (assoc rec :capped? true)

    :else
    (update rec :ticks conj {:dt    dt
                             :up    (boolean up?)
                             :left  (boolean left?)
                             :right (boolean right?)})))

;; ---------------------------------------------------------------------------
;; Submission payload (pure)

(def callsign-pattern
  "Server-side rule (submit-score): 1-16 chars of [A-Za-z0-9 _.-], starting
   alphanumeric."
  #"^[A-Za-z0-9][A-Za-z0-9 _.-]{0,15}$")

(defn valid-callsign? [s]
  (boolean (and (string? s) (re-matches callsign-pattern s))))

(defn landing-flag
  "Wire value for the AUTO/MANUAL flag: \"auto\" | \"manual\" | nil."
  [landing-mode]
  (case landing-mode
    :auto   "auto"
    :manual "manual"
    nil))

(defn landing-mode-from-flag
  "Inverse of `landing-flag`: a board row's wire value back to :auto/:manual/
   nil. Used to seed replay playback with the mode recorded at verification
   time (see moonlander.core/apply-recorded-landing-mode)."
  [flag]
  (case flag
    "auto"   :auto
    "manual" :manual
    nil))

(defn payload
  "Submit body for POST {SUPABASE_URL}/functions/v1/submit-score:
   {callsign, seed, level, landing_flag, ticks[{dt,up,left,right}]}.
   The score itself is derived server-side from the verified replay; the
   client never claims one."
  [callsign {:keys [seed level ticks]} landing-mode]
  {"callsign"     callsign
   "seed"         seed
   "level"        level
   "landing_flag" (landing-flag landing-mode)
   "ticks"        (mapv (fn [{:keys [dt up left right]}]
                          {"dt" dt "up" up "left" left "right" right})
                        ticks)})

;; ---------------------------------------------------------------------------
;; Board rendering (pure) - ASCII tables in the Apollo Telemetry look

(defn flag-label
  "Display label for a board row's landing flag."
  [f]
  (case f
    "auto"   "AUTO"
    "manual" "MANUAL"
    "--"))

(defn- fit
  "Fit `s` into exactly `n` chars: truncate or pad on the right."
  [s n]
  (let [s (str s)]
    (if (>= (count s) n)
      (subs s 0 n)
      (str s (apply str (repeat (- n (count s)) " "))))))

(defn- fit-left
  "Fit `s` into exactly `n` chars: truncate or pad on the left."
  [s n]
  (let [s (str s)]
    (if (>= (count s) n)
      (subs s 0 n)
      (str (apply str (repeat (- n (count s)) " ")) s))))

(def ^:private board-header
  (str (fit-left "RK" 2) "  " (fit "CALLSIGN" 16) "  "
       (fit-left "SCORE" 6) "  " (fit-left "LVL" 3) "  "
       (fit "FLAG" 6) "  " (fit-left "FUEL" 5)))

(defn board-row-text
  "One board line from a PostgREST row (string keys): rank, callsign,
   score, level, AUTO/MANUAL flag, fuel remaining."
  [i row]
  (str (fit-left (inc i) 2) "  "
       (fit (get row "callsign" "?") 16) "  "
       (fit-left (or (get row "score") 0) 6) "  "
       (fit-left (or (get row "level") 0) 3) "  "
       (fit (flag-label (get row "landing_flag")) 6) "  "
       (fit-left (int (or (get row "fuel_remaining") 0)) 5)))

(defn board-head-text
  "Board title, rule, and column header - the fixed part above the rows."
  [title]
  (let [rule (apply str (repeat (count board-header) "-"))]
    (str title "\n" rule "\n" board-header "\n" rule)))

(defn board-text
  "Full ASCII board with title, header, and one line per row; the
   `empty-message` shows when the board has no entries (e.g. the daily board
   right after the nightly reset)."
  [title rows empty-message]
  (let [body (if (seq rows)
               (str/join "\n" (map-indexed board-row-text rows))
               (str "  " empty-message))]
    (str (board-head-text title) "\n" body)))

;; ---------------------------------------------------------------------------
;; Replay theater (pure): parse an archived flight log back into sim input

(defn replay-log-from-row
  "Parse a stored flight log from a `score_replays` read-path row
   (string keys) into a replayable log {:id :seed :level :ticks}, or nil
   when the row carries no usable log: legacy rows predate the ticks
   column (NULL) and corrupt logs fail the same shape checks the server
   applies at submit time. The watch action degrades to 'replay
   unavailable' on nil - it must never crash the boards UI."
  [row]
  (let [ticks (get row "ticks")
        seed  (get row "seed")
        level (get row "level")
        tick? (fn [t]
                (let [dt (get t "dt")]
                  (and (number? dt) (> dt 0.0) (<= dt max-dt)
                       (boolean? (get t "up"))
                       (boolean? (get t "left"))
                       (boolean? (get t "right")))))]
    (when (and (integer? seed) (>= seed 0)
               (integer? level) (>= level 1)
               (sequential? ticks)
               (<= 1 (count ticks) max-ticks)
               (every? tick? ticks))
      {:id    (get row "id")
       :seed  seed
       :level level
       :ticks (mapv (fn [t] {:dt    (get t "dt")
                             :up    (get t "up")
                             :left  (get t "left")
                             :right (get t "right")})
                    ticks)})))

(def replay-speeds
  "Playback speed cycle for the SPEED toggle: 1x -> 2x -> 4x -> 1x."
  [1 2 4])

(defn cycle-replay-speed
  "Cycle a playback map's :speed through `replay-speeds`; a missing or
   unrecognized speed (e.g. the :loading/:unavailable window, which has no
   :speed key yet) resets to 1x rather than erroring."
  [rp]
  (update rp :speed #(get {1 2, 2 4} % 1)))

;; ---------------------------------------------------------------------------
;; UI state and DOM (browser only)

(defonce ui
  (atom {:recording     nil   ; current round's recording
         :ended-status  nil   ; :landed / :crashed once the round ends
         :landing-mode  nil   ; :auto / :manual of the ended round
         :submission    :idle ; :idle :sending :done :error
         :boards        {:status :idle :all nil :daily nil}
         :boards-open?  false
         :replay        nil   ; active replay playback (see watch!)
         }))

(defn- el [id]
  (when (exists? js/document)
    (.getElementById js/document id)))

(defn- set-text! [id s]
  (when-let [e (el id)]
    (set! (.-textContent e) s)))

(defn- show! [id show?]
  (when-let [e (el id)]
    (set! (.-hidden e) (not show?))))

(defn record!
  "Game-loop hook: record one simulated frame. `s` is the pre-step state,
   `burn` the post-step effective thrust. Starts a fresh recording whenever
   the round identity (seed, level) changes or the clock rewinds (retry or
   new game reusing a seed)."
  [s dt burn]
  (swap! ui update :recording
         (fn [rec]
           (let [fresh? (not (and rec
                                  (= (:seed rec) (:seed s))
                                  (= (:level rec) (:level s))
                                  (<= (:seen-t rec 0.0) (:t s))))]
             (record-tick
              (assoc (if fresh?
                       (new-recording (:seed s) (:level s))
                       rec)
                     :seen-t (:t s))
              dt burn)))))

(declare watch!)

(defn- append-board!
  "Build one board as DOM: the fixed header as a <pre>, then one line per
   row with a WATCH action (replay theater) when the row carries its id."
  [id title rows empty-message]
  (when-let [e (el id)]
    (.replaceChildren e)
    (let [head (.createElement js/document "pre")]
      (set! (.-textContent head) (board-head-text title))
      (.appendChild e head))
    (if (seq rows)
      (doseq [[i row] (map-indexed vector rows)]
        (let [div  (.createElement js/document "div")
              span (.createElement js/document "span")]
          ;; Top three entries get the vector-glow highlight (chrome only).
          (set! (.-className div) (if (< i 3) "lb-row lb-top" "lb-row"))
          (set! (.-textContent span) (board-row-text i row))
          (.appendChild div span)
          ;; WATCH only when the row archived a replayable log (has_log);
          ;; legacy rows predate the ticks column and get no action rather
          ;; than a fake one. A fetch/parse failure still degrades to a
          ;; clear 'replay unavailable' state.
          (when-let [rid (and (get row "has_log") (get row "id"))]
            (let [b (.createElement js/document "button")]
              (set! (.-className b) "lb-watch")
              (set! (.-textContent b) "WATCH")
              (.addEventListener
               b "click"
               (fn [_] (watch! rid (get row "callsign" "?")
                               (get row "level" "?")
                               (get row "landing_flag"))))
              (.appendChild div b)))
          (.appendChild e div)))
      (let [div (.createElement js/document "div")]
        (set! (.-className div) "lb-row")
        (set! (.-textContent div) (str "  " empty-message))
        (.appendChild e div)))))

(defn render-boards! []
  (let [{:keys [status all daily]} (:boards @ui)]
    (case status
      :loading (do (set-text! "lb-all" "ACQUIRING TELEMETRY...")
                   (set-text! "lb-daily" ""))
      :error   (do (set-text! "lb-all" "TELEMETRY OFFLINE - UPLINK UNREACHABLE")
                   (set-text! "lb-daily" ""))
      (do (append-board! "lb-all" "ALL-TIME BOARD" all
                         "NO TELEMETRY LOGGED YET")
          (append-board! "lb-daily" "DAILY BOARD (RESETS NIGHTLY UTC)"
                         daily "NO TELEMETRY TODAY")))))

(defn- get-json! [url anon-key path]
  (-> (js/fetch (str url path)
                #js {:headers #js {"apikey"        anon-key
                                   "Authorization" (str "Bearer " anon-key)}})
      (.then (fn [r]
               (if (.-ok r)
                 (.json r)
                 (throw (js/Error. (str "board read failed: " (.-status r)))))))
      (.then (fn [j] (js->clj j)))))

(defn fetch-boards! []
  (when-let [{:keys [url anon-key]} (config)]
    (swap! ui assoc-in [:boards :status] :loading)
    (render-boards!)
    (-> (js/Promise.all
         #js [(get-json! url anon-key
                         (str "/rest/v1/leaderboard_all_time?order=score.desc,fuel_remaining.desc&limit=" board-limit))
              (get-json! url anon-key
                         (str "/rest/v1/leaderboard_daily?order=score.desc,fuel_remaining.desc&limit=" board-limit))])
        (.then (fn [[all daily]]
                 (swap! ui assoc :boards {:status :ok :all all :daily daily})
                 (render-boards!)))
        (.catch (fn [_]
                  (swap! ui assoc-in [:boards :status] :error)
                  (render-boards!))))))

;; ---------------------------------------------------------------------------
;; Replay theater UI: fetch an archived flight log and hand it to the
;; playback driver (moonlander.core owns stepping/rendering of the replay
;; on the shared screen; this namespace owns fetching, parsing, and the
;; control bar).

(defn replay-status!
  "Set the replay bar's status line (also used by the playback driver)."
  [s]
  (set-text! "rp-status" s))

(defn update-replay-bar! []
  (when-let [rp (:replay @ui)]
    (set-text! "rp-play" (if (:playing? rp) "PAUSE" "PLAY"))
    (set-text! "rp-speed" (str "SPEED x" (:speed rp 1)))))

(defn- replay-unavailable! []
  (swap! ui assoc :replay {:status :unavailable})
  (replay-status! "REPLAY UNAVAILABLE - FLIGHT LOG NOT ARCHIVED")
  (update-replay-bar!))

;; Monotonic token for the in-flight WATCH fetch: guards against a stale
;; response from an earlier click overwriting a later one (e.g. double-click
;; or a slow network while switching rows before the first fetch resolves).
(defonce ^:private watch-token (atom 0))

(defn watch!
  "WATCH action on a board row: fetch the run's archived flight log via
   the anon read path and open the replay bar. The playback driver in
   moonlander.core picks the log up from (:replay @ui). A legacy row (log
   predates the ticks column) or a malformed log degrades to a clear
   'replay unavailable' state - the boards UI keeps working."
  [id callsign level landing-flag]
  (when-let [{:keys [url anon-key]} (config)]
    (let [token (swap! watch-token inc)
          current? #(= token @watch-token)]
      (swap! ui assoc :replay {:status :loading})
      (set-text! "rp-title" (str "REPLAY: " callsign " - LEVEL " level))
      (replay-status! "FETCHING FLIGHT LOG...")
      (show! "replay-bar" true)
      (-> (get-json! url anon-key
                     (str "/rest/v1/score_replays?id=eq." id "&limit=1"))
          (.then (fn [rows]
                   (when (current?)
                     (if-let [log (replay-log-from-row (first rows))]
                       (do (swap! ui assoc :replay
                                  {:status :ready
                                   :log (assoc log :landing-mode
                                               (landing-mode-from-flag
                                                landing-flag))})
                           (replay-status! "")
                           (update-replay-bar!))
                       (replay-unavailable!)))))
          (.catch (fn [_] (when (current?) (replay-unavailable!))))))))

(defn toggle-replay-play! []
  (swap! ui update-in [:replay :playing?] not)
  (update-replay-bar!))

(defn cycle-replay-speed! []
  (when (:speed (:replay @ui))
    (swap! ui update :replay cycle-replay-speed)
    (update-replay-bar!)))

(defn close-replay! []
  (swap! ui dissoc :replay)
  (show! "replay-bar" false))

(defn- update-submit-visibility! []
  (let [show-submit? (and (= :landed (:ended-status @ui))
                          (not= :done (:submission @ui)))]
    (show! "lb-callsign-label" show-submit?)
    (show! "lb-callsign" show-submit?)
    (show! "lb-transmit" show-submit?)))

(defn on-round-ended!
  "Round ended (landed or crashed): with config, bring up the telemetry
   panel. The callsign prompt appears only for a safe landing - submit time
   is the only moment a nickname is asked for."
  [s]
  (when (configured?)
    (swap! ui assoc
           :ended-status (:status s)
           :landing-mode (:landing-mode s)
           :submission :idle)
    (show! "leaderboard" true)
    (set-text! "lb-status"
               (if (= :landed (:status s))
                 "UPLINK READY - ENTER CALLSIGN TO LOG SCORE"
                 "NO SCORE TO LOG - [L] BOARDS"))
    (update-submit-visibility!)
    (show! "lb-boards" (:boards-open? @ui))
    (when (:boards-open? @ui)
      (fetch-boards!))))

(defn on-new-round!
  "A fresh round started (next level, retry, new game): put the panel away."
  []
  (swap! ui assoc :submission :idle :ended-status nil :boards-open? false)
  (close-replay!)
  (show! "leaderboard" false))

(defn toggle-boards!
  "Toggle the boards from the end-of-round screen ([L] key / BOARDS button)."
  []
  (when (configured?)
    (let [open? (not (:boards-open? @ui))]
      (swap! ui assoc :boards-open? open?)
      (show! "leaderboard" true)
      (show! "lb-boards" open?)
      (when open?
        (fetch-boards!)))))

(defn submit!
  "Transmit the recorded run for server verification. Validates the callsign
   against the server rule before sending; the score comes back from the
   verified replay."
  [callsign]
  (when-let [{:keys [url anon-key]} (config)]
    (let [{:keys [recording landing-mode submission]} @ui]
      (cond
        (not (valid-callsign? callsign))
        (set-text! "lb-status" "CALLSIGN: 1-16 CHARS [A-Z0-9 _.-], START ALNUM")

        (or (nil? recording) (empty? (:ticks recording)))
        (set-text! "lb-status" "NO TELEMETRY RECORDED")

        (:capped? recording)
        (set-text! "lb-status" "RUN TOO LONG FOR UPLINK - SCORE NOT LOGGED")

        (= :sending submission)
        nil

        :else
        (do
          (swap! ui assoc :submission :sending)
          (set-text! "lb-status" "TRANSMITTING...")
          (-> (js/fetch (str url "/functions/v1/submit-score")
                        #js {:method  "POST"
                             :headers #js {"content-type"  "application/json"
                                           "apikey"        anon-key
                                           "Authorization" (str "Bearer " anon-key)}
                             :body    (.stringify js/JSON
                                                  (clj->js (payload callsign
                                                                    recording
                                                                    landing-mode)))})
              (.then (fn [r]
                       (.then (.json r)
                              (fn [j] {:status (.-status r) :body (js->clj j)}))))
              (.then (fn [{:keys [status body]}]
                       (if (and (= 200 status) (get body "ok"))
                         (do
                           (swap! ui assoc :submission :done :boards-open? true)
                           (set-text! "lb-status"
                                      (str "SCORE VERIFIED: " (get body "score")
                                           " - TELEMETRY LOGGED"))
                           (update-submit-visibility!)
                           (show! "lb-boards" true)
                           (fetch-boards!))
                         (do
                           (swap! ui assoc :submission :error)
                           (set-text! "lb-status"
                                      (str "REJECTED: "
                                           (or (get body "reason")
                                               (str "HTTP " status))))))))
              (.catch (fn [_]
                        (swap! ui assoc :submission :error)
                        (set-text! "lb-status"
                                   "UPLINK FAILED - CHECK CONNECTION")))))))))

(defn init-ui!
  "Wire the telemetry panel controls once at game start. With no config the
   panel stays hidden and the page is exactly as before."
  []
  (when (configured?)
    (when-let [b (el "lb-transmit")]
      (.addEventListener b "click"
                         (fn [_] (submit! (.-value (el "lb-callsign"))))))
    (when-let [input (el "lb-callsign")]
      (.addEventListener input "keydown"
                         (fn [e]
                           (when (= "Enter" (.-key e))
                             (submit! (.-value input))))))
    (when-let [b (el "lb-boards-toggle")]
      (.addEventListener b "click" (fn [_] (toggle-boards!))))
    (when-let [help (el "help")]
      (set! (.-innerHTML help)
            (str (.-innerHTML help) " &nbsp; [L] BOARDS")))))
