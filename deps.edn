{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        ;; sift v0.2.0, the fleet-pinned CC source (fleet pin "8125fe8" is the
        ;; annotated tag; the sha below is the commit the tag points at).
        io.github.typmk/sift {:git/tag "v0.2.0" :git/sha "8c195369d9b4c391213e5d1f67764c49ee7d0a10"}}
 :aliases
 {:crank {:main-opts ["-m" "crank.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner" "-d" "test"]
         :exec-fn cognitect.test-runner.api/test}}}
